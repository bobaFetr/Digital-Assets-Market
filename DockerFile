# ====== Build Frontend (Vite + React) ======
FROM node:18-alpine AS frontend-build
WORKDIR /frontend

COPY frontend/package*.json ./
RUN npm install

COPY frontend .
RUN npm run build


# ====== Build Backend (.NET 8 Web API) ======
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS backend-build
WORKDIR /backend

COPY backend/*.csproj .
RUN dotnet restore

COPY backend .
RUN dotnet publish -c Release -o /app


# ====== Final Runtime Image ======
FROM alpine:3.19

# Install Nginx + .NET runtime + supervisor
RUN apk add --no-cache \
    nginx \
    supervisor \
    icu-data-full \
    && wget https://dot.net/v1/dotnet-install.sh \
    && chmod +x dotnet-install.sh \
    && ./dotnet-install.sh --version 8.0.0 --runtime aspnetcore \
    && rm dotnet-install.sh

# Create folders
RUN mkdir -p /var/www/frontend /var/log/supervisor

# Copy frontend build
COPY --from=frontend-build /frontend/dist /var/www/frontend

# Copy backend
COPY --from=backend-build /app /app

# Copy configs
COPY nginx.conf /etc/nginx/nginx.conf
COPY supervisord.conf /etc/supervisord.conf

EXPOSE 80

# Start Nginx + .NET API
CMD ["supervisord", "-c", "/etc/supervisord.conf"]
